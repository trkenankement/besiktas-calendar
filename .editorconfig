root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,html,svg}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ICS dosyaları RFC 5545 gereği CRLF ile biter; olduğu gibi kalmalı.
[*.ics]
end_of_line = crlf
trim_trailing_whitespace = false
